+
+def average(values: Sequence[float]) -> float:
+    """Return the arithmetic mean of ``values``.
+
+    ``fsum`` keeps the accumulation stable for long inputs. Raises ``ValueError`` on an empty
+    sequence: the mean of nothing is undefined.
+    """
+    items = list(values)
+    if not items:
+        raise ValueError("values must not be empty")
+    return fsum(items) / len(items)
