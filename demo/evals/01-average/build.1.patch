+import pytest
+
+import calc
+from calc import average
+
+
+def test_exported():
+    assert "average" in calc.__all__
+
+
+def test_mean_of_three():
+    assert average([1, 2, 3]) == pytest.approx(2.0)
+
+
+def test_negatives_allowed():
+    assert average([-1, 1]) == pytest.approx(0.0)
+
+
+def test_empty_raises():
+    with pytest.raises(ValueError):
+        average([])
