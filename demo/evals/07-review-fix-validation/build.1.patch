@@ -14,3 +16,10 @@ def compound(principal: float, rate: float, years: int, periods_per_year: int =
         raise ValueError("invalid arguments")
     n = periods_per_year
     return principal * (1 + rate / n) ** (n * years)
+
+
+def variance(values: Sequence[float]) -> float:
+    """Return the POPULATION variance of ``values`` (divided by n, not n-1)."""
+    items = list(values)
+    mean = fsum(items) / len(items)
+    return fsum((x - mean) ** 2 for x in items) / len(items)
