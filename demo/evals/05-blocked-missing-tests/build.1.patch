+def median(values: Sequence[float]) -> float:
+    """Return the middle value of ``values`` (the mean of the two middle ones when even).
+
+    Sorts a copy, so the caller's sequence is untouched. Raises ``ValueError`` when empty.
+    """
+    items = sorted(values)
+    if not items:
+        raise ValueError("values must not be empty")
+    mid = len(items) // 2
+    if len(items) % 2:
+        return items[mid]
+    return (items[mid - 1] + items[mid]) / 2
