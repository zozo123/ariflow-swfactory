@@ -0,0 +1,24 @@
+import math
+
+import pytest
+
+from calc import compound, simple_interest
+
+
+def test_nan_principal_rejected():
+    with pytest.raises(ValueError):
+        simple_interest(math.nan, 0.05, 2)
+
+
+def test_inf_rate_rejected():
+    with pytest.raises(ValueError):
+        compound(1000, math.inf, 2)
+
+
+def test_message_names_argument():
+    with pytest.raises(ValueError, match="principal"):
+        simple_interest(math.nan, 0.05, 2)
+
+
+def test_finite_path_unchanged():
+    assert simple_interest(1000, 0.05, 2) == pytest.approx(100.0)
