+import pytest
+
+import calc
+from calc import round_fraction
+
+
+def test_exported():
+    assert "round_fraction" in calc.__all__
+
+
+def test_rounds_to_two_places():
+    assert round_fraction(0.25348712456) == pytest.approx(0.25)
+
+
+def test_places_argument():
+    assert round_fraction(0.25348712456, 3) == pytest.approx(0.253)
+
+
+def test_negative_places_rejected():
+    with pytest.raises(ValueError):
+        round_fraction(0.25, -1)
