+import pytest
+
+import calc
+from calc import drawdown
+
+
+def test_exported():
+    assert "drawdown" in calc.__all__
+
+
+def test_decline_is_positive():
+    assert drawdown(100, 75) == pytest.approx(0.25)
+
+
+def test_zero_peak_raises():
+    with pytest.raises(ValueError):
+        drawdown(0, 10)
+
+
+def test_gain_is_negative():
+    assert drawdown(100, 125) == pytest.approx(-0.25)
