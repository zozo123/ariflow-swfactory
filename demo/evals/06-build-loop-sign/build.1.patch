@@ -14,3 +14,14 @@ def compound(principal: float, rate: float, years: int, periods_per_year: int =
         raise ValueError("invalid arguments")
     n = periods_per_year
     return principal * (1 + rate / n) ** (n * years)
+
+
+def drawdown(peak: float, trough: float) -> float:
+    """Return the decline from ``peak`` to ``trough`` as a fraction of the peak.
+
+    A decline is positive: ``drawdown(100, 75)`` is ``0.25``. Raises ``ValueError`` when
+    ``peak`` is zero — there is no decline from nothing.
+    """
+    if peak == 0:
+        raise ValueError("peak must be non-zero")
+    return (trough - peak) / peak
