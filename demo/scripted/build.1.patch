+
+
+def percent_change(old: float, new: float) -> float:
+    """Return the relative change from ``old`` to ``new`` as a fraction (0.25 == +25%).
+
+    Raises ``ValueError`` when ``old`` is zero: the change is undefined.
+    """
+    if old == 0:
+        raise ValueError("old must be non-zero")
+    return (old - new) / old
