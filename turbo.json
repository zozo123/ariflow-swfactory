{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "stream",
  "noUpdateNotifier": true,
  "remoteCache": {
    "enabled": false
  },
  "futureFlags": {
    "experimentalCargoWorkspaces": true,
    "experimentalPythonWorkspaces": true,
    "experimentalTaskCommand": true,
    "affectedUsingTaskInputs": true,
    "githubActionsRemoteBaseRefFallback": true
  },
  "tasks": {
    "swfactory-python#test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!README.md",
        "!CHANGELOG.md",
        "!docs/**",
        "!site/**",
        "$TURBO_ROOT$/tests/**"
      ]
    },
    "swfactory-rust#test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tests/fixtures/contract/**"
      ]
    },
    "swf-cli#build": {},
    "//#polyglot-verification": {
      "cache": false,
      "dependsOn": [
        "swfactory-python#test",
        "swfactory-rust#test",
        "swf-cli#build"
      ]
    }
  }
}
