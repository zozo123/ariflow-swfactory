{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "stream",
  "noUpdateNotifier": true,
  "remoteCache": {
    "enabled": false
  },
  "futureFlags": {
    "experimentalPythonWorkspaces": true,
    "experimentalTaskCommand": true
  },
  "tasks": {
    "//#rust-build": {
      "command": [
        "cargo",
        "build",
        "--manifest-path",
        "rust/Cargo.toml",
        "--workspace",
        "--locked"
      ],
      "cache": false,
      "inputs": [
        "$TURBO_ROOT$/rust/Cargo.toml",
        "$TURBO_ROOT$/rust/Cargo.lock",
        "$TURBO_ROOT$/rust/crates/**"
      ]
    },
    "//#rust-domain-contract": {
      "command": [
        "cargo",
        "test",
        "--manifest-path",
        "rust/Cargo.toml",
        "-p",
        "swf-domain",
        "--test",
        "contract",
        "--locked"
      ],
      "cache": false,
      "dependsOn": [
        "//#rust-build"
      ],
      "inputs": [
        "$TURBO_ROOT$/rust/Cargo.toml",
        "$TURBO_ROOT$/rust/Cargo.lock",
        "$TURBO_ROOT$/rust/crates/swf-domain/**"
      ]
    },
    "swfactory-python#test": {
      "dependsOn": [
        "//#rust-build"
      ]
    },
    "//#polyglot-contract": {
      "dependsOn": [
        "swfactory-python#test",
        "//#rust-domain-contract"
      ]
    }
  }
}
