{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "stream",
  "noUpdateNotifier": true,
  "remoteCache": {
    "enabled": false
  },
  "futureFlags": {
    "experimentalCargoWorkspaces": true,
    "experimentalPythonWorkspaces": true,
    "experimentalTaskCommand": true,
    "affectedUsingTaskInputs": true,
    "githubActionsRemoteBaseRefFallback": true
  },
  "tasks": {
    "swfactory-python#test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!$TURBO_ROOT$/rust/**/*.rs"
      ]
    },
    "swfactory-rust#test": {
      "inputs": [
        "$TURBO_ROOT$/Cargo.toml",
        "$TURBO_ROOT$/Cargo.lock",
        "$TURBO_ROOT$/rust-toolchain.toml",
        "$TURBO_ROOT$/rust/crates/**",
        "$TURBO_ROOT$/tests/fixtures/contract/**"
      ]
    },
    "swf-cli#build": {
      "inputs": [
        "$TURBO_ROOT$/Cargo.toml",
        "$TURBO_ROOT$/Cargo.lock",
        "$TURBO_ROOT$/rust-toolchain.toml",
        "$TURBO_ROOT$/rust/crates/**"
      ]
    },
    "//#polyglot-verification": {
      "cache": false,
      "dependsOn": [
        "swfactory-python#test",
        "swfactory-rust#test",
        "swf-cli#build"
      ],
      "inputs": [
        "$TURBO_ROOT$/turbo.json"
      ]
    }
  }
}
