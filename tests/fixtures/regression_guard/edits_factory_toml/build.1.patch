diff --git a/src/calc/core.py b/src/calc/core.py
--- a/src/calc/core.py
+++ b/src/calc/core.py
@@ -14,3 +14,13 @@ def compound(principal: float, rate: float, years: int, periods_per_year: int =
         raise ValueError("invalid arguments")
     n = periods_per_year
     return principal * (1 + rate / n) ** (n * years)
+
+
+def percent_change(old: float, new: float) -> float:
+    """Return the relative change from ``old`` to ``new`` as a fraction (0.25 == +25%).
+
+    Raises ``ValueError`` when ``old`` is zero: the change is undefined.
+    """
+    if old == 0:
+        raise ValueError("old must be non-zero")
+    return (new - old) / old
diff --git a/tests/test_percent_change.py b/tests/test_percent_change.py
new file mode 100644
--- /dev/null
+++ b/tests/test_percent_change.py
@@ -0,0 +1,21 @@
+import pytest
+
+import calc
+from calc import percent_change
+
+
+def test_exported():
+    assert "percent_change" in calc.__all__
+
+
+def test_increase():
+    assert percent_change(100, 125) == pytest.approx(0.25)
+
+
+def test_decrease():
+    assert percent_change(200, 150) == pytest.approx(-0.25)
+
+
+def test_zero_old_raises():
+    with pytest.raises(ValueError):
+        percent_change(0, 5)
