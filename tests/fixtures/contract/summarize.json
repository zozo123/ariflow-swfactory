        "runs": [
          {
            "run_id": "a",
            "agent": "claude",
            "first_pass_ci": true,
            "iterations": 2,
            "cycle_s": 10.0,
            "tests_passed": true,
            "findings_by_severity": {
              "blocker": 1,
              "major": 2,
              "minor": 3,
              "nit": 4
