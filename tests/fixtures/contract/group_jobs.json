      "expected": [
        {
          "dag_id": "factory",
          "run_id": "r1",
          "map_index": 0,
          "issue": "-",
          "state": "queued",
          "tasks": [
            {
              "task_id": "job.setup",
              "map_index": 0,
              "state": null
            }
          ]
        },
        {
          "dag_id": "factory",
          "run_id": "r1",
          "map_index": 2,
          "issue": "-",
          "state": "failed",
          "tasks": [
            {
              "task_id": "job.setup",
              "map_index": 2,
              "state": "failed"
            }
          ]
        },
        {
          "dag_id": "factory",
          "run_id": "r1",
          "map_index": 5,
          "issue": "-",
          "state": "success",
          "tasks": [
            {
              "task_id": "job.setup",
              "map_index": 5,
              "state": "success"
            }
          ]
        }
      ]
    },
