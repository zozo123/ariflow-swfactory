{
  "function": "group_jobs",
  "doc": "group_jobs buckets task instances by map_index, drops the unmapped row once any mapped task exists, and names each row's issue from fan_out or from an unambiguous single fallback.",
  "cases": [
    {
      "name": "empty_tasks_yield_no_rows",
      "input": {
        "dag_id": "factory",
        "run_id": "r1",
        "tasks": []
      },
      "expected": []
    },
    {
      "name": "only_unmapped_yields_one_placeholder",
      "input": {
        "dag_id": "factory",
        "run_id": "r1",
        "tasks": [
          {
            "task_id": "fan_out",
            "map_index": -1,
            "state": "running"
          }
        ]
      },
      "expected": [
        {
          "dag_id": "factory",
          "run_id": "r1",
          "map_index": -1,
          "issue": "-",
          "state": "running",
          "tasks": [
            {
              "task_id": "fan_out",
              "map_index": -1,
              "state": "running"
            }
          ]
        }
      ]
    },
    {
      "name": "unmapped_dropped_once_mapped_exists",
      "input": {
        "dag_id": "factory",
        "run_id": "r1",
        "tasks": [
          {
            "task_id": "fan_out",
            "map_index": -1,
            "state": "success"
          },
          {
            "task_id": "job.setup",
            "map_index": 0,
            "state": "success"
          }
        ]
      },
      "expected": [
        {
          "dag_id": "factory",
          "run_id": "r1",
          "map_index": 0,
          "issue": "-",
          "state": "success",
          "tasks": [
            {
              "task_id": "job.setup",
              "map_index": 0,
              "state": "success"
            }
          ]
        }
      ]
    },
    {
      "name": "gaps_in_indices_are_kept",
      "input": {
        "dag_id": "factory",
        "run_id": "r1",
        "tasks": [
          {
            "task_id": "job.setup",
            "map_index": 5,
            "state": "success"
          },
          {
            "task_id": "job.setup",
            "map_index": 0,
            "state": null
